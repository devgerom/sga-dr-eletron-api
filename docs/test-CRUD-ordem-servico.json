        },
        "url": "http://localhost:3000/auth/reset-password"
      }
    },
    {
      "name": "5. OS - Criar",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer SEU_TOKEN_AQUI"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"numero\": 1003,\n  \"clienteId\": 1,\n  \"descricaoProblema\": \"Equipamento não liga\",\n  \"equipamento\": \"Notebook\"\n}"
        },
        "url": "http://localhost:3000/ordens-servico"
      }
    },
    {
