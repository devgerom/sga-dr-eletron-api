{
  "info": {
    "name": "SGA - Dr. Eletron",
    "description": "Coleção de testes da API do projeto integrador"
  },
  "item": [
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "http://localhost:3000/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"geronimo@teste.com\",\n  \"senha\": \"123456\"\n}"
        }
      }
    },
    {
      "name": "Criar Categoria",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer SEU_TOKEN_AQUI" }
        ],
        "url": "http://localhost:3000/categorias",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Veículo\"\n}"
        }
      }
    },
    {
      "name": "Listar Categorias",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer SEU_TOKEN_AQUI" }],
        "url": "http://localhost:3000/categorias"
      }
    },
    {
      "name": "Atualizar Categoria",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer SEU_TOKEN_AQUI" }
        ],
        "url": "http://localhost:3000/categorias/1",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Veículos e Peças\"\n}"
        }
      }
    },
    {
      "name": "Excluir Categoria",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer SEU_TOKEN_AQUI" }],
        "url": "http://localhost:3000/categorias/1"
      }
    }
  ]
}