{
  "info": {
    "name": "SGA - Dr. Eletron",
    "description": "Coleção de testes da API do projeto integrador (Auth + CRUD de Categoria)"
  },
  "item": [
    {
      "name": "1. Auth - Cadastro de Usuário",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "http://localhost:3000/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Gerónimo\",\n  \"email\": \"geronimo@teste.com\",\n  \"senha\": \"123456\"\n}"
        }
      }
    },
    {
      "name": "2. Auth - Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "http://localhost:3000/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"geronimo@teste.com\",\n  \"senha\": \"123456\"\n}"
        }
      }
    },
    {
      "name": "3. Auth - Esqueci a Senha",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "http://localhost:3000/auth/forgot-password",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"geronimo@teste.com\"\n}"
        }
      }
    },
    {
      "name": "4. Auth - Redefinir Senha",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "http://localhost:3000/auth/reset-password",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"COLE_O_TOKEN_AQUI\",\n  \"novaSenha\": \"654321\"\n}"
        }
      }
    },
    {
      "name": "5. Categoria - Criar",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer SEU_TOKEN_AQUI" }
        ],
        "url": "http://localhost:3000/categorias",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Veículo\"\n}"
        }
      }
    },
    {
      "name": "6. Categoria - Listar Todas",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer SEU_TOKEN_AQUI" }],
        "url": "http://localhost:3000/categorias"
      }
    },
    {
      "name": "7. Categoria - Buscar por ID",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer SEU_TOKEN_AQUI" }],
        "url": "http://localhost:3000/categorias/1"
      }
    },
    {
      "name": "8. Categoria - Atualizar",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer SEU_TOKEN_AQUI" }
        ],
        "url": "http://localhost:3000/categorias/1",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Veículos e Peças\"\n}"
        }
      }
    },
    {
      "name": "9. Categoria - Excluir",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer SEU_TOKEN_AQUI" }],
        "url": "http://localhost:3000/categorias/1"
      }
    }
  ]
}